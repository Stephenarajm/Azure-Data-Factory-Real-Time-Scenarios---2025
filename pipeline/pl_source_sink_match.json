						"referenceName": "ds_target_scenario2",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "Get Metadata source",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_source_scenario2",
